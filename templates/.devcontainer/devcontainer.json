{
  "name": "gkvm",
  "image": "ghcr.io/glueckkanja/gkvm-tools:v0",
  "workspaceFolder": "/src",
  "workspaceMount": "source=${localWorkspaceFolder},target=/src,type=bind",
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "OpenTofu.vscode-opentofu",
        "hashicorp.terraform"
      ]
    }
  }
}
